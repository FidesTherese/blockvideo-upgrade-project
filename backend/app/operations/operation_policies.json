{
  "schema_version": 1,
  "global_negative_phrases": [
    "何もしない",
    "実行しない",
    "変更しない",
    "do nothing",
    "do not execute",
    "don't execute"
  ],
  "negated_clause_pattern": "(?:(?!して|って|んで|いて|えて|けて|せて|めて|べて|れて|きて|みて|にて|ちて)[^、。,.!！?？])*?(?:ないで|ないこと|なくていい|なくてよい|なくて大丈夫)(?:ください|ね|ほしい|おいて)?",
  "negation_residue_pattern": "[ 、。,.!！?？]*(?:です|ね|よ|お願いします)?[ 、。,.!！?？]*",
  "follow_up_generation": {
    "operation_id": "project.generation.start",
    "operation_version": 1,
    "arguments": {"kind": "full"}
  },
  "references": {
    "artifact": {
      "patterns": ["(?:動画|成果物|artifact)\\s*(?:id|番号)?\\s*[:=#]?\\s*(\\d+)\\s*(?:番)?(?!\\s*(?:px|ピクセル|倍|秒|%))"],
      "marker": "(?:動画|成果物|artifact)",
      "answer_prefix": "動画 ",
      "question": "戻したい完成動画の番号を「動画 3」のように1つ指定してください（出力履歴の「動画 N を開く」の番号です）。"
    },
    "job": {
      "patterns": ["(?:ジョブ|job)(?:[_\\s]*id)?\\s*[:=#]?\\s*(\\d+)"],
      "marker": "(?:ジョブ|job)",
      "answer_prefix": "ジョブ ",
      "question": "対象のジョブ番号を「ジョブ7」のように1つ指定してください。"
    },
    "revision": {
      "patterns": [
        "(?:revision|リビジョン|設定(?:の)?(?:版|バージョン))\\s*[:=#]?\\s*(\\d+)",
        "(?:第)?(\\d+)\\s*版"
      ],
      "marker": "(?:revision|リビジョン|版|バージョン)",
      "answer_prefix": "revision ",
      "question": "戻したい設定の版番号を「revision 2」のように1つ指定してください。"
    }
  },
  "operations": {
    "project.artifact.restore": {
      "mutates": true,
      "requires_confirmation": false,
      "negative_phrases": ["戻さない"],
      "reference": {"argument": "artifact_id", "kind": "artifact"}
    },
    "project.generation.cancel": {
      "mutates": true,
      "requires_confirmation": false,
      "negative_phrases": ["止めない", "中止しない", "キャンセルしない", "取り消さない", "停止しない", "do not cancel", "don't cancel"],
      "reference": {"argument": "job_id", "kind": "job"}
    },
    "project.generation.retry": {
      "mutates": true,
      "requires_confirmation": true,
      "negative_phrases": ["再試行しない", "再実行しない", "やり直さない", "do not retry", "don't retry"],
      "reference": {"argument": "job_id", "kind": "job"}
    },
    "project.generation.start": {
      "mutates": true,
      "requires_confirmation": true,
      "negative_phrases": ["作らない", "生成しない", "開始しない", "作り直さない", "do not generate", "don't generate"]
    },
    "project.settings.restore": {
      "mutates": true,
      "requires_confirmation": false,
      "negative_phrases": ["戻さない"],
      "reference": {"argument": "revision", "kind": "revision"}
    },
    "project.settings.update": {
      "mutates": true,
      "requires_confirmation": false,
      "allows_generate_after_save": true,
      "requires_arguments": true,
      "settings_views": {
        "1": {"settings_at": ""},
        "2": {"settings_at": "settings", "aliases": {"subtitle_font_size_delta": "subtitle_font_size_delta"}}
      }
    },
    "project.status.get": {
      "mutates": false,
      "requires_confirmation": false
    },
    "project.subtitle-font-size.adjust": {
      "mutates": true,
      "requires_confirmation": false,
      "allows_generate_after_save": true,
      "settings_views": {"1": {"aliases": {"delta": "subtitle_font_size_delta"}}}
    },
    "project.subtitle-font-size.set": {
      "mutates": true,
      "requires_confirmation": false,
      "allows_generate_after_save": true,
      "settings_views": {"1": {"aliases": {"value": "subtitle_font_size"}}}
    }
  }
}
